# Stripe API keys - get them from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-publishable-key

# Optional: used to verify Stripe webhook signatures
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret

# Supabase server-side credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used for Stripe success/cancel redirects
PUBLIC_URL=http://localhost:3000

PORT=3000
